{
    "name": "terah/redis-cache",
    "description": "A very simple redis caching lib with hierarchical keys",
    "keywords": [
        "terah",
        "redis-cache"
    ],
    "homepage": "https://github.com/terah/redis-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "Terry Cullen",
            "email": "terry@terah.com.au",
            "homepage": "http://terrycullen.com.au",
            "role": "Developer"
        }
    ],
    "require": {
        "php" : ">=7.0",
        "psr/log": "1.*",
        "terah/fluent-assert": "3.*"
    },
    "require-dev": {
        "scrutinizer/ocular": "~1.1"
    },
    "autoload": {
        "psr-4": {
            "Terah\\RedisCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Terah\\RedisCache\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    }
}
