{
    "name": "terah/redis-cache",
    "description": "A very simple redis caching lib with hierarchical keys",
    "keywords": [
        "terah",
        "redis-cache"
    ],
    "homepage": "https://github.com/terah/redis-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "Terry Cullen",
            "email": "terry@terah.com.au",
            "homepage": "terrycullen.com.au",
            "role": "Developer"
        }
    ],
    "require": {
        "php" : ">=5.3.0"
    },
    "require-dev": {
        "phpunit/phpunit" : "4.*",
        "scrutinizer/ocular": "~1.1",
        "squizlabs/php_codesniffer": "~2.3"
    },
    "autoload": {
        "psr-4": {
            "terah\\redis-cache\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "terah\\redis-cache\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    }
}
